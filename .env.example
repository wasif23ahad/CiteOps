# =============================================================================
# CiteOps Environment Configuration (.env.example)
# Copy to `.env` for local development. Never commit `.env` with real secrets.
# =============================================================================

# --- Core Application ---
APP_NAME=CiteOps
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Shared secret between Next.js BFF proxy and FastAPI (leave empty only for local Swagger testing)
CITEOPS_INTERNAL_API_KEY=dev-internal-key-change-me
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL 17 + pgvector >= 0.8.0 ---
POSTGRES_USER=citeops
POSTGRES_PASSWORD=citeops_dev_password
POSTGRES_DB=citeops
# Runtime connection string (Phase 1+ switches runtime pool to non-BYPASSRLS role `citeops_app`)
DATABASE_URL=postgresql://citeops:citeops_dev_password@localhost:5432/citeops
# Admin/Migrator connection string used only by `app.db.migrate`
DATABASE_ADMIN_URL=postgresql://citeops:citeops_dev_password@localhost:5432/citeops

# --- Redis 8 (Local) / Upstash Redis (Cloud Free) ---
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_MAX_ENTRIES=500
CACHE_TTL_SECONDS=86400

# --- Rate Limiting ---
RATE_LIMIT_TENANT_RPM=20
RATE_LIMIT_GLOBAL_LLM_RPM=12

# --- LLM Configuration (Free Tier Primary + Failover + Privacy Switch) ---
# Options: gemini | ollama
LLM_PROVIDER=gemini
# Obtain free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# low | medium | high (low recommended for low-latency RAG synthesis)
GEMINI_THINKING_LEVEL=low

# Optional Secondary API Fallback on Gemini 429 (https://console.groq.com)
GROQ_API_KEY=
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# Optional Local Privacy Mode (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Embeddings Configuration ---
# Options: gemini | fastembed
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Must match PostgreSQL `document_chunks.embedding` dimension (default: 768)
EMBEDDING_DIM=768

# --- Cross-Encoder Reranker Configuration ---
# light = Xenova/ms-marco-MiniLM-L-6-v2 (~80 MB, safe for 512 MB cloud hosts)
# base  = BAAI/bge-reranker-base (~1.04 GB, local Docker / 16 GB HF Spaces)
RERANKER_PROFILE=light
RERANK_CANDIDATE_COUNT=25
MIN_RERANK_SCORE=0.35

# --- Langfuse v3+ OpenTelemetry Observability (Free Hobby Cloud) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Next.js Frontend (Server-Only BFF Proxy Config) ---
CITEOPS_API_URL=http://localhost:8000
